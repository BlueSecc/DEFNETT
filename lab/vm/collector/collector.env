# DEFNETT lab - env collector
DB_PATH=/evidence/events.sqlite3
ALLOWED_HOSTS=server-a,server-b
DEMO_REPAIR_HOST=all
DEMO_REPAIR_DELAY_SECONDS=15
# HTTPS endpoints on the Collector VM. Install the lab CA before enabling services.
EXECUTOR_URL=https://127.0.0.1:8092
EXECUTOR_API_TOKEN=GANTI-TOKEN-EXECUTOR
APPROVAL_AUTHORITY_URL=https://127.0.0.1:8093
APPROVAL_COLLECTOR_TOKEN=GANTI-TOKEN-COLLECTOR-AUTHORITY
APPROVAL_CA_FILE=/etc/defnett/tls/ca.crt
APPROVAL_TLS_REQUIRED=true
DASHBOARD_TLS_PORT=8443
DASHBOARD_TLS_CERT_FILE=/etc/defnett/tls/collector-vm.crt
DASHBOARD_TLS_KEY_FILE=/etc/defnett/tls/collector-vm.key
COOKIE_SECURE=true
SSL_CERT_FILE=/etc/defnett/tls/ca.crt
