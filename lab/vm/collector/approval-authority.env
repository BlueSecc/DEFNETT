# Root-owned mode 0600. Use independent random tokens; never reuse executor API token.
DB_PATH=/var/lib/defnett-approval/approvals.sqlite3
OPERATOR_AUTH_FILE=/etc/defnett/operator_auth.json
APPROVAL_BIND_HOST=127.0.0.1
APPROVAL_PORT=8093
APPROVAL_COLLECTOR_TOKEN=GANTI-TOKEN-COLLECTOR-AUTHORITY
APPROVAL_EXECUTOR_TOKEN=GANTI-TOKEN-EXECUTOR-AUTHORITY
APPROVAL_TLS_REQUIRED=true
TLS_CERT_FILE=/etc/defnett/tls/approval-authority.crt
TLS_KEY_FILE=/etc/defnett/tls/approval-authority.key
TLS_CA_FILE=/etc/defnett/tls/ca.crt
COOKIE_SECURE=true
