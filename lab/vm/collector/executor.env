# DEFNETT lab - env executor (VM collector; proses terpisah dari collector)
DB_PATH=/evidence/events.sqlite3
ALLOWED_HOSTS=server-a,server-b
EXECUTOR_API_TOKEN=GANTI-TOKEN-EXECUTOR
EXECUTOR_BIND_HOST=127.0.0.1
HAPROXY_HOST=192.168.56.10
REMEDIATOR_URL_SERVER_A=https://192.168.56.11:8091/v1/repair
REMEDIATOR_URL_SERVER_B=https://192.168.56.12:8091/v1/repair
DEMO_REPAIR_HOST=all
DEMO_REPAIR_DELAY_SECONDS=15
OPERATOR_APPROVAL_TTL_SECONDS=900
APPROVAL_AUTHORITY_URL=https://127.0.0.1:8093
APPROVAL_EXECUTOR_TOKEN=GANTI-TOKEN-EXECUTOR-AUTHORITY
APPROVAL_CA_FILE=/etc/defnett/tls/ca.crt
APPROVAL_TLS_REQUIRED=true
TLS_CERT_FILE=/etc/defnett/tls/executor-vm.crt
TLS_KEY_FILE=/etc/defnett/tls/executor-vm.key
SSL_CERT_FILE=/etc/defnett/tls/ca.crt
